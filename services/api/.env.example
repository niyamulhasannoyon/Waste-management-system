# PostgreSQL 16 + PostGIS 3.4
DATABASE_URL=postgres://clean_savar:clean_savar_dev_password@localhost:5432/clean_savar

# Server configuration
API_BIND_ADDR=0.0.0.0:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth & OTP settings
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
SESSION_TTL_SECONDS=2592000
REQUIRE_AUTH=false

# Geospatial settings (meters)
COMPLAINT_DUPLICATE_RADIUS_METERS=50
WORKERS_NEARBY_DEFAULT_RADIUS_METERS=5000
