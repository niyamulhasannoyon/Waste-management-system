# =============================================================================
# Clean Savar (ক্লিন সাভার) — Environment Configuration Template
# Copy to .env for local development. Never commit real secrets.
# =============================================================================

# PostgreSQL 16 + PostGIS
POSTGRES_DB=clean_savar
POSTGRES_USER=clean_savar
POSTGRES_PASSWORD=replace_with_local_postgres_password
DATABASE_URL=postgres://clean_savar:replace_with_local_postgres_password@localhost:5432/clean_savar

# Environment Mode ('development' | 'production')
# Setting APP_ENV=production fails closed if ALLOW_INSECURE_DEV_DEFAULTS or OTP_DEV_MODE is true.
APP_ENV=development

# Security & Auth (MANDATORY in production)
# Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_SECRET=replace_with_32_plus_byte_random_hex_secret
ALLOW_INSECURE_DEV_DEFAULTS=false
OTP_DEV_MODE=false
OTP_TTL_SECONDS=300
SESSION_TTL_SECONDS=604800

# Comma-separated phone numbers provisioned/promoted as admins when signing in via OTP
# Leave empty unless provisioning an initial admin; set explicitly in staging/prod secrets only.
ADMIN_BOOTSTRAP_PHONES=

# Optional comma-separated trusted reverse proxy IPs (e.g. 127.0.0.1,172.18.0.2)
# TRUSTED_PROXY_IPS=

# API Server
API_BIND_ADDR=0.0.0.0:8080
# Logging format ('pretty' | 'json'; defaults to 'json' when APP_ENV=production)
LOG_FORMAT=pretty
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:8080/uploads
MAX_UPLOAD_BYTES=5242880
COMPLAINT_DUPLICATE_RADIUS_METERS=50
WORKERS_NEARBY_DEFAULT_RADIUS_METERS=5000

# Next.js Web App
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_ANDROID_CLIENT_ID=replace_with_google_android_client_id
